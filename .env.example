# ---------------------------------------------------------------------------
# Backend (Render).  Copy to backend/.env for local development.
# ---------------------------------------------------------------------------

# Supabase — Project Settings → Data API / API Keys
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service_role secret — backend only, never in the browser>

# Shared secret for POST /api/cron/scrape. Generate your own:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=<64 hex characters>

# Comma-separated list of origins allowed to call the API.
# Use * only for local development.
CORS_ORIGINS=https://<your-app>.vercel.app

# The one site this project is permitted to scrape.
STORE_BASE_URL=https://demo.inelabteamdev.com

PORT=8080
NODE_ENV=production
LOG_LEVEL=info

# ---- scraper tuning (defaults are the values Phase 1 measured) -------------
SCRAPE_MAX_ATTEMPTS=4
SCRAPE_CONCURRENCY=3
SCRAPE_RUN_BUDGET_MS=240000
SCRAPE_HEADERS_TIMEOUT_MS=12000
SCRAPE_BODY_TIMEOUT_MS=20000
# Minimum gap between outbound store requests. The store tolerates ~2 req/s;
# 700ms (~1.3 req/s) sits inside that with room for jitter. See STORE_NOTES.md §8.
STORE_MIN_REQUEST_GAP_MS=700
# Reject a price that moves more than this fraction without a second opinion.
MAX_PRICE_DELTA_RATIO=0.7
# Playwright fallback. Off by default: Chromium costs ~300MB, which is most of
# Render's free tier. See DESIGN_NOTE.md § trade-offs.
BROWSER_FALLBACK_ENABLED=false

# ---- optional: email alerts (bonus) ---------------------------------------
SENDGRID_API_KEY=
ALERT_TO_EMAIL=
ALERT_FROM_EMAIL=

# ---------------------------------------------------------------------------
# Frontend (Vercel).  Copy to frontend/.env.local for local development.
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=https://<your-service>.onrender.com
