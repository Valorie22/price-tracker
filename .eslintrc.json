{
  "root": true,
  "env": { "node": true, "browser": true, "es2023": true },
  "parser": "@typescript-eslint/parser",
  "parserOptions": { "ecmaVersion": 2023, "sourceType": "module", "ecmaFeatures": { "jsx": true } },
  "plugins": ["@typescript-eslint"],
  "extends": ["eslint:recommended", "plugin:@typescript-eslint/recommended"],
  "ignorePatterns": ["dist", "node_modules", "recon", "*.config.js", "*.config.ts"],
  "rules": {
    "@typescript-eslint/no-unused-vars": ["error", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }],
    "@typescript-eslint/no-explicit-any": "error",
    "@typescript-eslint/consistent-type-imports": ["warn", { "prefer": "type-imports", "fixStyle": "inline-type-imports" }],
    "no-console": ["warn", { "allow": ["warn", "error"] }],
    "eqeqeq": ["error", "smart"],
    "prefer-const": "error",
    "no-var": "error"
  },
  "overrides": [
    {
      "files": ["frontend/src/**/*.tsx", "frontend/src/**/*.ts"],
      "plugins": ["react-hooks"],
      "extends": ["plugin:react-hooks/recommended"],
      "settings": { "react": { "version": "18" } }
    },
    {
      "files": ["backend/tests/**/*.ts", "backend/scripts/**/*.ts"],
      "rules": { "no-console": "off", "@typescript-eslint/no-unused-vars": "warn" }
    }
  ]
}
